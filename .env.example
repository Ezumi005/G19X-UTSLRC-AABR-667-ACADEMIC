# Copia este archivo como .env en la raiz del proyecto y ajusta los valores.
# .env esta excluido de Git (.gitignore): las credenciales nunca se versionan.

DATABASE_URL=postgresql://postgres:TU_CONTRASENA@localhost:5432/motor_segmentacion

# Opcional: URL de la API CRM simulada para POST /ingestion/sync
# SIMULATOR_URL=http://127.0.0.1:8001

# Azure OpenAI (recomendaciones por segmento; ver README seccion 8)
AZURE_OPENAI_ENDPOINT=https://openai-motor-seg.openai.azure.com/
AZURE_OPENAI_API_KEY=tu-clave
AZURE_OPENAI_DEPLOYMENT=gpt-5-4-mini

# Scoring de inferencia en Azure (App Service; el artefacto esta registrado en Azure ML)
# AZURE_SCORING_URL=https://motor-seg-scoring.azurewebsites.net
# AZURE_SCORING_KEY=tu-clave
